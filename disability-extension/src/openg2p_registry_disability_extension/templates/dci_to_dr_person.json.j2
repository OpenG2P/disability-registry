{# ===========================================================================
   Inbound: SPDCI Disability Registry data objects -> PersonWithDisability.

   The OUTPUT keys are registry field names for the master register, plus one
   key per non-scalar SECTION MNEMONIC (see
   meta_data/register-metadata/g2p_register_sections.sql). A key that matches no
   section mnemonic is dropped silently, which is the usual reason an ingested
   record arrives with blank tables — so the mnemonics below and that file must
   be changed together.

   Values arrive as human wording ("Severe impairment or difficulty",
   "Maintenance medicine") and must leave as ENUM members: the ORM rejects
   anything else. Each macro therefore maps a permissive set of inbound spellings
   onto exactly one enum value, and falls through to '' rather than guessing —
   an empty optional field is recoverable, a wrong one is not.
   =========================================================================== #}
{%- macro norm(v) -%}{{ (v or '') | string | trim | upper | replace('-', '_') | replace(' ', '_') }}{%- endmacro -%}
{%- macro gender_enum(sex) -%}
{%- set s = norm(sex) -%}
{%- if s in ['MALE', 'M'] -%}MALE
{%- elif s in ['FEMALE', 'F'] -%}FEMALE
{%- elif s in ['OTHER', 'OTHERS'] -%}OTHERS
{%- else -%}UNKNOWN
{%- endif -%}
{%- endmacro -%}
{%- macro marital_enum(ms) -%}
{%- set s = norm(ms) -%}
{%- if s in ['SINGLE', 'MARRIED', 'DIVORCED', 'WIDOWED', 'SEPARATED', 'UNKNOWN'] -%}{{ s }}
{%- else -%}UNKNOWN
{%- endif -%}
{%- endmacro -%}
{%- macro disability_status_enum(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['ASSESSED_DISABLED', 'ASSESSED_NOT_DISABLED', 'PENDING_ASSESSMENT', 'SELF_DECLARED', 'UNKNOWN'] -%}{{ s }}
{%- elif 'PENDING' in s -%}PENDING_ASSESSMENT
{%- elif 'SELF' in s -%}SELF_DECLARED
{%- elif s in ['YES', 'TRUE', 'DISABLED'] -%}ASSESSED_DISABLED
{%- elif s in ['NO', 'FALSE', 'NOT_DISABLED'] -%}ASSESSED_NOT_DISABLED
{%- elif s -%}UNKNOWN
{%- endif -%}
{%- endmacro -%}
{%- macro status_level_enum(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['NONE', 'MILD', 'MODERATE', 'SEVERE', 'PROFOUND'] -%}{{ s }}
{%- elif 'PROFOUND' in s or 'COMPLETE' in s or 'TOTAL' in s -%}PROFOUND
{%- elif 'SEVERE' in s -%}SEVERE
{%- elif 'MODERATE' in s -%}MODERATE
{%- elif 'MILD' in s -%}MILD
{%- endif -%}
{%- endmacro -%}
{%- macro impairment_type_enum(v) -%}
{%- set s = norm(v) -%}
{%- if 'DEAFBLIND' in s -%}DEAFBLIND
{%- elif 'VISUAL' in s or 'VISION' in s or 'SEEING' in s or 'BLIND' in s -%}VISUAL
{%- elif 'HEARING' in s or 'DEAF' in s -%}HEARING
{%- elif 'SPEECH' in s or 'LANGUAGE' in s -%}SPEECH_LANGUAGE
{%- elif 'INTELLECTUAL' in s -%}INTELLECTUAL
{%- elif 'PSYCHOSOCIAL' in s or 'MENTAL' in s -%}PSYCHOSOCIAL
{%- elif 'NEURO' in s -%}NEUROLOGICAL
{%- elif 'LEARNING' in s -%}LEARNING
{%- elif 'CHRONIC' in s -%}CHRONIC_ILLNESS
{%- elif 'MULTIPLE' in s -%}MULTIPLE
{%- elif 'PHYSICAL' in s or 'MOBILITY' in s or 'WALK' in s or 'CLIMB' in s -%}PHYSICAL_MOBILITY
{%- elif s -%}OTHER
{%- endif -%}
{%- endmacro -%}
{# The four Washington Group points, accepting both the raw scale and the
   "... impairment or difficulty" wording the outbound template emits. #}
{%- macro impairment_level_enum(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['NO_DIFFICULTY', 'SOME_DIFFICULTY', 'A_LOT_OF_DIFFICULTY', 'CANNOT_DO_AT_ALL'] -%}{{ s }}
{%- elif s.startswith('NO_') or s == 'NONE' -%}NO_DIFFICULTY
{%- elif 'COMPLETE' in s or 'UNABLE' in s or 'CANNOT' in s or 'PROFOUND' in s -%}CANNOT_DO_AT_ALL
{%- elif 'SEVERE' in s or 'A_LOT' in s -%}A_LOT_OF_DIFFICULTY
{%- elif 'MILD' in s or 'SOME' in s or 'MODERATE' in s -%}SOME_DIFFICULTY
{%- endif -%}
{%- endmacro -%}
{%- macro impairment_cause_enum(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['CONGENITAL', 'ILLNESS', 'WORK_ACCIDENT', 'ROAD_ACCIDENT', 'OTHER_ACCIDENT', 'CONFLICT_VIOLENCE', 'NATURAL_DISASTER', 'AGEING', 'MEDICAL_COMPLICATION', 'UNKNOWN', 'OTHER'] -%}{{ s }}
{%- elif 'BIRTH' in s or 'CONGENITAL' in s -%}CONGENITAL
{%- elif 'WORK' in s or 'OCCUPATIONAL' in s -%}WORK_ACCIDENT
{%- elif 'ROAD' in s or 'TRAFFIC' in s -%}ROAD_ACCIDENT
{%- elif 'ACCIDENT' in s -%}OTHER_ACCIDENT
{%- elif 'CONFLICT' in s or 'VIOLENCE' in s or 'WAR' in s -%}CONFLICT_VIOLENCE
{%- elif 'DISASTER' in s -%}NATURAL_DISASTER
{%- elif 'AGE' in s -%}AGEING
{%- elif 'DISEASE' in s or 'ILLNESS' in s -%}ILLNESS
{%- elif 'MEDICAL' in s -%}MEDICAL_COMPLICATION
{%- elif s -%}OTHER
{%- endif -%}
{%- endmacro -%}
{%- macro support_status_enum(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['REQUIRED', 'RECEIVING', 'RECEIVED', 'PARTIALLY_RECEIVED', 'NOT_REQUIRED', 'DISCONTINUED'] -%}{{ s }}
{%- elif 'NOT_REQUIRED' in s or 'NOT_NEEDED' in s -%}NOT_REQUIRED
{%- elif 'PARTIAL' in s -%}PARTIALLY_RECEIVED
{%- elif 'DISCONTINU' in s or 'STOPPED' in s -%}DISCONTINUED
{%- elif 'RECEIVING' in s -%}RECEIVING
{%- elif 'RECEIVED' in s -%}RECEIVED
{%- elif 'REQUIR' in s or 'NEED' in s -%}REQUIRED
{%- endif -%}
{%- endmacro -%}
{%- macro frequency_enum(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['PERMANENT', 'DAILY', 'WEEKLY', 'MONTHLY', 'OCCASIONAL', 'AS_NEEDED', 'TEMPORARY'] -%}{{ s }}
