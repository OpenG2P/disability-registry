{%- elif 'DAILY' in s -%}DAILY
{%- elif 'WEEK' in s -%}WEEKLY
{%- elif 'MONTH' in s -%}MONTHLY
{%- elif 'NEED' in s or 'DEMAND' in s -%}AS_NEEDED
{%- elif 'TEMPORARY' in s -%}TEMPORARY
{%- elif s -%}OCCASIONAL
{%- endif -%}
{%- endmacro -%}
{%- macro human_assistance_enum(v) -%}
