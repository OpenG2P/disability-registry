{# yes(1)/no(0) per DO.DR.02. Anything unrecognised stays null: "not stated" and
   "states they are not disabled" are different answers. #}
{%- macro self_id_bool(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['1', 'TRUE', 'YES', 'Y'] -%}true
{%- elif s in ['0', 'FALSE', 'NO', 'N'] -%}false
{%- else -%}null
{%- endif -%}
{%- endmacro -%}
{%- macro first_str(value) -%}
{%- if value is string -%}{{ value | trim }}
{%- elif value is mapping -%}{{ (value.get('number') or value.get('email') or value.get('value') or '') | string | trim }}
{%- elif value is iterable and value -%}
  {%- set item = value | first -%}
  {%- if item is string -%}{{ item | trim }}
  {%- elif item is mapping -%}{{ (item.get('number') or item.get('email') or item.get('value') or '') | string | trim }}
  {%- endif -%}
{%- endif -%}
{%- endmacro -%}
{%- set rec = expanded -%}
{%- set demo = rec.get('demographic_info') or {} -%}
{%- set name = demo.get('name') or {} -%}
{%- set addl_raw = rec.get('additional_attributes') -%}
{%- set addl = namespace(map={}) -%}
{%- if addl_raw is mapping -%}
  {%- set addl.map = addl_raw -%}
{%- elif addl_raw is iterable and addl_raw is not string -%}
  {%- set merged = {} -%}
  {%- for item in addl_raw -%}
    {%- if item is mapping -%}{%- set _ = merged.update(item) -%}{%- endif -%}
  {%- endfor -%}
  {%- set addl.map = merged -%}
{%- endif -%}
{%- set a = addl.map -%}
{%- set support = rec.get('disability_support') or {} -%}
{%- set details = rec.get('disability_details') or [] -%}
{%- set human = support.get('human_assistance') or [] -%}
{%- set assistive = support.get('assistive_technology') or [] -%}
{%- set medical = support.get('medical_care') or [] -%}
{%- set housing = support.get('housing_support') or [] -%}
{%- set animal = support.get('animal_assistance') or [] -%}
{%- set relatives = rec.get('related_person') or [] -%}
{%- set programs = rec.get('programs_enrolments') or [] -%}
{%- set identifiers = rec.get('member_identifier') or [] -%}
{%- set uin = namespace(value='') -%}
{%- for identifier in identifiers -%}
  {%- if identifier is mapping and not uin.value and identifier.get('identifier_type') in ['UIN', 'uin'] -%}
    {%- set uin.value = identifier.get('identifier_value') | string | trim -%}
  {%- endif -%}
{%- endfor -%}
{%- set nid = namespace(value='') -%}
{%- for identifier in (demo.get('identifier') or []) -%}
  {%- if identifier is mapping and not nid.value -%}
    {%- set nid.value = identifier.get('identifier_value') | string | trim -%}
  {%- endif -%}
{%- endfor -%}
{%- set address = (demo.get('address') or [{}]) | first -%}
{%- set phone = first_str(demo.get('phone_number')) -%}
{%- set email = first_str(demo.get('email')) -%}
{
  "first_name": {{ (name.get('given_name') or '') | tojson }},
  "middle_name": {{ (name.get('second_name') or '') | tojson }},
  "last_name": {{ (name.get('surname') or '') | tojson }},
  "prefix": {{ (name.get('prefix') or '') | tojson }},
  "suffix": {{ (name.get('suffix') or '') | tojson }},
  "full_name": {{ ((name.get('given_name') or '') ~ ' ' ~ (name.get('surname') or '')) | trim | tojson }},
  "gender": {{ gender_enum(demo.get('sex')) | tojson }},
  "birth_date": {{ (demo.get('birth_date') or '') | string | tojson }},
  "death_date": {{ (demo.get('death_date') or '') | string | tojson }},
  "marital_status": {{ marital_enum(rec.get('marital_status')) | tojson }},
  "occupation": {{ (rec.get('occupation') or '') | string | trim | tojson }},
  "income_level": {{ (rec.get('income_level') or '') | string | trim | upper | replace(' ', '_') | tojson }},
  "education_level": {{ (rec.get('education_level') or '') | string | trim | upper | replace(' ', '_') | tojson }},
  "language_code": {{ ((rec.get('language_code') or []) | join(',') if rec.get('language_code') is iterable and rec.get('language_code') is not string else (rec.get('language_code') or '')) | string | tojson }},
  "registration_date": {{ (rec.get('registration_date') or demo.get('registration_date') or '') | string | tojson }},
  "person_identifier": [
    {
      "foundational_id": {{ (nid.value or uin.value) | tojson }},
      "identity_evidence_type": {{ ('FOUNDATIONAL_ID_VERIFIED' if nid.value else 'NONE') | tojson }},
      "registration_channel": "SOCIAL_REGISTRY_TRANSFER"
    }
  ],
  "person_contact_details": [
    {
      "phone_numbers": [{{ phone | tojson }}],
      "emails": [{{ email | tojson }}]
    }
  ],
  "person_location_details": [
    {
      "address_line_1": {{ (address.get('address_line_1') if address is mapping else '') | default('', true) | string | tojson }},
      "address_line_2": {{ (address.get('address_line_2') if address is mapping else '') | default('', true) | string | tojson }},
      "postal_code": {{ (address.get('postal_code') if address is mapping else '') | default('', true) | string | tojson }},
      "country_code": {{ (address.get('country_code') if address is mapping else '') | default('', true) | string | tojson }}
    }
  ],
  "disability_status_and_assessment": [
    {
      "self_id_disability": {{ self_id_bool(rec.get('self_id_disability')) }},
      "disability_status": {{ disability_status_enum(rec.get('disability_status')) | tojson }},
      "disability_status_level": {{ status_level_enum(rec.get('disability_status_level')) | tojson }},
      "assessment_date": {{ (a.get('assessment_date') or '') | string | tojson }},
      "assessment_authority": {{ (a.get('assessment_authority') or '') | string | tojson }},
      "certificate_expiry_date": {{ (a.get('certificate_expiry_date') or '') | string | tojson }}
    }
  ],
  "living_situation": [
    {
      "housing_type": {{ housing_type_enum(rec.get('housing_type')) | tojson }},
      "transport_requirement": {{ transport_enum(rec.get('transport_requirement')) | tojson }},
      "legal_capacity_status": {{ (a.get('legal_capacity_status') or '') | string | trim | upper | replace(' ', '_') | tojson }}
    }
  ],
  "socio_economic_profile": [
    {
      "employment_status": {{ employment_enum(rec.get('employment_status')) | tojson }}
    }
  ],
  "disability_details": [
    {%- for row in details -%}
    {
      "impairment_type": {{ impairment_type_enum(row.get('impairment_type')) | tojson }},
      "impairment_level": {{ impairment_level_enum(row.get('impairment_level')) | tojson }},
      "impairment_cause": {{ impairment_cause_enum(row.get('impairment_cause')) | tojson }},
      "age_on_set": {% if row.get('age_on_set') is none %}null{% else %}{{ row.get('age_on_set') | int }}{% endif %},
      "is_primary_impairment": {% if loop.first %}true{% else %}false{% endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "human_assistance": [
    {%- for row in human -%}
    {
      "assistance_type": {{ human_assistance_enum(row.get('type')) | tojson }},
      "frequency": {{ frequency_enum(row.get('frequency')) | tojson }},
      "support_status": {{ support_status_enum(row.get('support_status')) | tojson }},
      "caregiver_name": {{ ((row.get('caregiver') or {}).get('name') if row.get('caregiver') is mapping else row.get('caregiver')) | default('', true) | string | tojson }},
      "caregiver_identifier": {{ ((row.get('caregiver') or {}).get('identifier') if row.get('caregiver') is mapping else '') | default('', true) | string | tojson }},
      "caregiver_relationship": {{ caregiver_rel_enum(row.get('relationship')) | tojson }},
      "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
      "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "assistive_technology": [
    {%- for row in assistive -%}
    {
      "assistive_technology_type": {{ assistive_tech_enum(row.get('type')) | tojson }},
      "support_status": {{ support_status_enum(row.get('support_status')) | tojson }},
      "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
      "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "medical_care": [
    {%- for row in medical -%}
    {
      "medical_care_type": {{ medical_care_enum(row.get('type')) | tojson }},
      "support_status": {{ support_status_enum(row.get('support_status')) | tojson }},
      "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
      "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "housing_support": [
    {%- for row in housing -%}
    {
      "housing_support_type": {{ housing_support_enum(row.get('type')) | tojson }},
      "support_status": {{ support_status_enum(row.get('support_status')) | tojson }},
      "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
      "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "animal_assistance": [
    {%- for row in animal -%}
    {
      "animal_assistance_type": {{ animal_assistance_enum(row.get('type')) | tojson }},
      "support_status": {{ support_status_enum(row.get('support_status')) | tojson }},
      "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
      "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "related_persons": [
    {%- for row in relatives -%}
    {%- set member = row.get('related_member') or {} -%}
    {%- set member_ids = member.get('member_identifier') or [] -%}
    {
      "relationship_type": {{ relationship_enum(row.get('relationship_type')) | tojson }},
      "related_person_name": {{ (member.get('name') or '') | string | tojson }},
      "related_person_identifier": {{ ((member_ids | first).get('identifier_value') if member_ids and (member_ids | first) is mapping else '') | default('', true) | string | tojson }},
      "is_primary_caregiver": {% if row.get('is_primary_caregiver') %}true{% else %}false{% endif %},
      "is_legal_guardian": {% if row.get('is_legal_guardian') %}true{% else %}false{% endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "program_enrolments": [
    {%- for row in programs -%}
    {
      "program_name": {{ (row.get('program_name') or '') | string | tojson }},
      "program_identifier": {{ (row.get('program_identifier') or '') | string | tojson }},
      "enrolment_status": {{ enrolment_status_enum(row.get('enrolment_status')) | tojson }},
      "enrolment_start_date": {{ (row.get('enrolment_start_date') or '') | string | tojson }},
      "enrolment_end_date": {{ (row.get('enrolment_end_date') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ]
}
