{# ===========================================================================
   Outbound: PersonWithDisability -> SPDCI Disability Registry data objects.

   Renders DO.DR.03 PersonwithDisability, carrying DO.DR.01 DRPerson inside
   `demographic_info` and DO.DR.02 Member's socio-economic attributes alongside.

   IMPORTANT — the TOP-LEVEL keys of this document are the registry's CONSENT
   SCOPES. Adding a key here creates a scope a partner can be granted; renaming
   one silently revokes access for every partner consented to the old name.
   The sanity e2e consents to `demographic_info` and asserts nothing outside its
   consented scopes comes back.

   Child registers arrive under the snake_case of their register mnemonic
   (registry-core `_to_snake_case`), which for this registry happens to match the
   SPDCI object names: disability_detail, human_assistance, assistive_technology,
   medical_care, housing_support, animal_assistance, related_person,
   program_enrolment.
   =========================================================================== #}
{%- macro norm(value) -%}
{{- (value or '') | string | trim | upper -}}
{%- endmacro -%}
{# Sentence case: MAINTENANCE_MEDICINE -> "Maintenance medicine". This is the
   wording style the SPDCI examples use for support and care types. #}
{%- macro sentence(value) -%}
{%- set v = (value or '') | string | trim | replace('_', ' ') | lower -%}
{%- if v -%}{{ v[0] | upper }}{{ v[1:] }}{%- endif -%}
{%- endmacro -%}
{# Title case: WORK_ACCIDENT -> "Work Accident", matching the DO.DR.04 example. #}
{%- macro titled(value) -%}
{{- (value or '') | string | trim | replace('_', ' ') | lower | title -}}
{%- endmacro -%}
{%- macro sex(value) -%}
{%- set v = norm(value) -%}
{%- if v in ['MALE', 'M'] -%}male
{%- elif v in ['FEMALE', 'F'] -%}female
{%- elif v in ['OTHERS', 'OTHER'] -%}others
{%- elif v -%}{{ v | lower }}
{%- else -%}unknown
{%- endif -%}
{%- endmacro -%}
{# DO.DR.04 impairment_level. The registry stores the Washington Group scale;
   the standard's own example wording is "Severe impairment or difficulty", so
   the four WG points are mapped onto that phrasing rather than emitted raw. #}
{%- macro impairment_level_cd(value) -%}
{%- set v = norm(value) -%}
{%- if v == 'NO_DIFFICULTY' -%}No impairment or difficulty
{%- elif v == 'SOME_DIFFICULTY' -%}Mild impairment or difficulty
{%- elif v == 'A_LOT_OF_DIFFICULTY' -%}Severe impairment or difficulty
{%- elif v == 'CANNOT_DO_AT_ALL' -%}Complete impairment or difficulty
{%- elif v -%}{{ sentence(value) }}
{%- endif -%}
{%- endmacro -%}
{%- macro relationship_cd(value) -%}
{%- set v = norm(value) -%}
{%- if v == 'OTHER_RELATIVE' -%}relative
{%- elif v == 'NON_RELATIVE' -%}associate
{%- elif v -%}{{ v | lower | replace('_', ' ') }}
{%- endif -%}
{%- endmacro -%}
{%- macro employment_cd(value) -%}
{{- (value or '') | string | trim | lower | replace('_', ' ') -}}
{%- endmacro -%}
{# Contacts: G2PPerson stores phone_numbers/emails as JSONB, which senders have
   variously produced as a list of strings, a list of objects, or a stringified
   list. Flattened into a real list here — never `{% set x = macro() %}` on a
   macro that prints a list, which yields markup instead of items. #}
{%- macro contact_append_from_raw(raw, target) -%}
{%- if raw is string -%}
  {%- set t = raw | trim -%}
  {%- if t | length >= 2 and t[0:1] == '[' and t[-1:] == ']' -%}
    {%- set inner = t[1:-1] | trim -%}
    {%- if inner -%}
      {%- set flat = inner | replace("'", '') | replace('"', '') -%}
      {%- for part in flat.split(',') -%}
        {%- set piece = part | trim -%}
        {%- if piece -%}{%- set _ = target.append(piece) -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- elif t -%}
    {%- set _ = target.append(t) -%}
  {%- endif -%}
{%- elif raw is mapping -%}
  {%- set n = raw.get('number') or raw.get('phone_number') or raw.get('email') or raw.get('value') -%}
  {%- if n -%}{%- set _ = target.append(n | string | trim) -%}{%- endif -%}
{%- elif raw is iterable -%}
  {%- for item in raw -%}
    {%- if item is string -%}
      {%- if item | trim -%}{%- set _ = target.append(item | trim) -%}{%- endif -%}
    {%- elif item is mapping -%}
      {%- set n = item.get('number') or item.get('phone_number') or item.get('email') or item.get('value') -%}
      {%- if n -%}{%- set _ = target.append(n | string | trim) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- set p = expanded -%}
{%- set phone_list = [] -%}
{%- set _ = contact_append_from_raw(p.get('phone_numbers'), phone_list) -%}
{%- set email_list = [] -%}
{%- set _ = contact_append_from_raw(p.get('emails'), email_list) -%}
{%- set details = p.get('disability_detail') or [] -%}
{%- set human = p.get('human_assistance') or [] -%}
{%- set assistive = p.get('assistive_technology') or [] -%}
{%- set medical = p.get('medical_care') or [] -%}
{%- set housing = p.get('housing_support') or [] -%}
{%- set animal = p.get('animal_assistance') or [] -%}
{%- set relatives = p.get('related_person') or [] -%}
{%- set programs = p.get('program_enrolment') or [] -%}
{%- set uin_val = p.get('functional_record_id') or '' -%}
{%- set nid_val = p.get('foundational_id') or '' -%}
{%- set langs = namespace(items=[]) -%}
{%- if p.get('language_code') %}
  {%- for part in (p.get('language_code') | string).split(',') -%}
    {%- set piece = part | trim -%}
    {%- if piece -%}{%- set _ = langs.items.append(piece | lower) -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- set comm_needs = p.get('communication_needs') or [] -%}
{
  "@context": {
    "spdci": "https://schema.spdci.org/core/v1/data",
    "dr": "https://schema.spdci.org/disability-registry/v1/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "common": "https://schema.spdci.org/common/v1/"
  },
  "@id": {{ ('https://disability-registry.example.org/person/' ~ uin_val) | tojson }},
  "@type": "dr:PersonwithDisability",
  "member_identifier": [
    {
      "@type": "Identifier",
      "identifier_type": "UIN",
      "identifier_value": {{ uin_val | tojson }}
    }
    {%- if p.get('disability_certificate_number') -%},
    {
      "@type": "Identifier",
      "identifier_type": "DisabilityCertificate",
      "identifier_value": {{ p.get('disability_certificate_number') | tojson }}
    }
    {%- endif -%}
  ],
  "demographic_info": {
    "@type": "DRPerson",
    "identifier": [
      {
        "@type": "Identifier",
        "identifier_type": "NationalID",
        "identifier_value": {{ nid_val | tojson }}
      }
    ],
    "name": {
      "@type": "Name",
      "given_name": {{ (p.get('first_name') or p.get('given_name') or '') | tojson }},
      "second_name": {{ (p.get('middle_name') or '') | tojson }},
      "surname": {{ (p.get('last_name') or '') | tojson }},
      "prefix": {{ (p.get('prefix') or '') | tojson }},
      "suffix": {{ (p.get('suffix') or '') | tojson }}
    },
    "sex": {{ sex(p.get('gender')) | tojson }},
    "birth_date": {{ (p.get('birth_date') | string if p.get('birth_date') is not none else '') | tojson }},
    "death_date": {{ (p.get('death_date') | string if p.get('death_date') is not none else '') | tojson }},
    "address": [
      {
        "@type": "Address",
        "address_line_1": {{ (p.get('address_line_1') or '') | tojson }},
        "address_line_2": {{ (p.get('address_line_2') or '') | tojson }},
        "postal_code": {{ (p.get('postal_code') or '') | tojson }},
        "country_code": {{ (p.get('country_code') or '') | tojson }}
      }
    ],
    "phone_number": [
      {%- for phone in phone_list -%}
      {{ phone | tojson }}{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ],
    "email": [
      {%- for email in email_list -%}
      {{ email | tojson }}{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ],
    "registration_date": {{ (p.get('registration_date') or p.get('created_at') or '') | string | tojson }},
    "last_updated": {{ (p.get('last_approved_at') or '') | string | tojson }}
  },
  "self_id_disability": {% if p.get('self_id_disability') is none %}null{% elif p.get('self_id_disability') %}1{% else %}0{% endif %},
  "disability_status": {{ sentence(p.get('disability_status')) | tojson }},
  "disability_status_level": {{ sentence(p.get('disability_status_level')) | tojson }},
  "disability_details": [
    {%- for row in details -%}
    {
      "@type": "dr:DisabilityDetails",
      "impairment_type": {{ sentence(row.get('impairment_type')) | tojson }},
      "impairment_level": {{ impairment_level_cd(row.get('impairment_level')) | tojson }},
      "impairment_cause": {{ titled(row.get('impairment_cause')) | tojson }},
      "age_on_set": {% if row.get('age_on_set') is none %}null{% else %}{{ row.get('age_on_set') }}{% endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  {# DO.DR.05 DisabilitySupport is a CONTAINER, not a table: it groups the five
     support objects. Modelled here as one scope so a partner consenting to
     "support needs" gets a coherent picture rather than five disjoint grants. #}
  "disability_support": {
    "@type": "dr:DisabilitySupport",
    "human_assistance": [
      {%- for row in human -%}
      {
        "@type": "dr:HumanAssistance",
        "type": {{ (row.get('assistance_type') or '') | string | trim | lower | replace('_', ' ') | tojson }},
        "frequency": {{ sentence(row.get('frequency')) | tojson }},
        "support_status": {{ sentence(row.get('support_status')) | tojson }},
        "caregiver": {
          "@type": "Person",
          "name": {{ (row.get('caregiver_name') or '') | tojson }},
          "identifier": {{ (row.get('caregiver_identifier') or '') | tojson }}
        },
        "relationship": {{ relationship_cd(row.get('caregiver_relationship')) | tojson }},
        "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
        "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ],
    "assistive_technology": [
      {%- for row in assistive -%}
      {
        "@type": "dr:AssistiveTechnology",
        "type": {{ sentence(row.get('assistive_technology_type')) | tojson }},
        "support_status": {{ sentence(row.get('support_status')) | tojson }},
        "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
        "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ],
    "medical_care": [
      {%- for row in medical -%}
      {
        "@type": "dr:MedicalCare",
        "type": {{ sentence(row.get('medical_care_type')) | tojson }},
        "support_status": {{ sentence(row.get('support_status')) | tojson }},
        "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
        "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ],
    "housing_support": [
      {%- for row in housing -%}
      {
        "@type": "dr:HousingSupport",
        "type": {{ sentence(row.get('housing_support_type')) | tojson }},
        "support_status": {{ sentence(row.get('support_status')) | tojson }},
        "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
        "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ],
    "animal_assistance": [
      {%- for row in animal -%}
      {
        "@type": "dr:AnimalAssistance",
        "type": {{ sentence(row.get('animal_assistance_type')) | tojson }},
        "support_status": {{ sentence(row.get('support_status')) | tojson }},
        "registration_date": {{ (row.get('registration_date') or '') | string | tojson }},
        "last_updated": {{ (row.get('last_updated') or '') | string | tojson }}
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ]
  },
  "transport_requirement": {{ sentence(p.get('transport_requirement')) | tojson }},
  "housing_type": {{ sentence(p.get('housing_type')) | tojson }},
  "related_person": [
    {%- for row in relatives -%}
    {
      "@type": "RelatedPerson",
      "relationship_type": {{ relationship_cd(row.get('relationship_type')) | tojson }},
      "related_member": {
        "@type": "Member",
        "member_identifier": [
          {
            "@type": "Identifier",
            "identifier_type": "UIN",
            "identifier_value": {{ (row.get('related_person_identifier') or '') | tojson }}
          }
        ],
        "name": {{ (row.get('related_person_name') or '') | tojson }}
      },
      "is_primary_caregiver": {% if row.get('is_primary_caregiver') %}true{% else %}false{% endif %},
      "is_legal_guardian": {% if row.get('is_legal_guardian') %}true{% else %}false{% endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "programs_enrolments": [
    {%- for row in programs -%}
    {
      "@type": "ProgramEnrolment",
      "program_name": {{ (row.get('program_name') or '') | tojson }},
      "program_identifier": {{ (row.get('program_identifier') or '') | tojson }},
      "enrolment_status": {{ sentence(row.get('enrolment_status')) | tojson }},
      "enrolment_start_date": {{ (row.get('enrolment_start_date') or '') | string | tojson }},
      "enrolment_end_date": {{ (row.get('enrolment_end_date') or '') | string | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "marital_status": {{ (p.get('marital_status') or '') | string | trim | lower | replace('_', ' ') | tojson }},
  "employment_status": {{ employment_cd(p.get('employment_status')) | tojson }},
  "occupation": {{ (p.get('occupation') or '') | string | trim | lower | replace('_', ' ') | tojson }},
  "income_level": {{ (p.get('income_level') or '') | string | trim | lower | replace('_', ' ') | tojson }},
  "education_level": {{ (p.get('education_level') or '') | string | trim | lower | replace('_', ' ') | tojson }},
  "language_code": {% if langs.items %}{{ langs.items | tojson }}{% else %}[]{% endif %},
  "additional_attributes": [
    {
      "support_needs_level": {{ sentence(p.get('support_needs_level')) | tojson }},
      "legal_capacity_status": {{ sentence(p.get('legal_capacity_status')) | tojson }},
      "communication_needs": {% if comm_needs %}{{ comm_needs | tojson }}{% else %}[]{% endif %},
      "assessment_date": {{ (p.get('assessment_date') or '') | string | tojson }},
      "assessment_authority": {{ (p.get('assessment_authority') or '') | tojson }},
      "certificate_expiry_date": {{ (p.get('certificate_expiry_date') or '') | string | tojson }},
      "unmet_support_needs_count": {% if p.get('unmet_support_needs_count') is none %}null{% else %}{{ p.get('unmet_support_needs_count') }}{% endif %},
      "registration_channel": {{ (p.get('registration_channel') or '') | string | trim | lower | replace('_', ' ') | tojson }}
    }
  ],
  "registration_date": {{ (p.get('registration_date') or p.get('created_at') or '') | string | tojson }},
  "last_updated": {{ (p.get('last_approved_at') or '') | string | tojson }}
}
